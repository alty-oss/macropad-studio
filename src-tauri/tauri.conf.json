{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macropad Studio",
  "identifier": "com.macropad.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "bun scripts/dev-server.ts",
    "beforeBuildCommand": "bun run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macropad Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 660,
        "center": true,
        "visible": false,
        "backgroundColor": "#18191b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyOUQ5QTM3MTZGMzc2NzcKUldSM2R2TVdONXFkQWhqT2xKSDhBVlR0QWw2Vmd6aFNVMm9ROEMvYzcvcjhoMlZkWjJnNGtLbjcK",
      "endpoints": [
        "https://github.com/alty-oss/macropad-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
