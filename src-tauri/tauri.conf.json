{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macropad Studio",
  "version": "0.2.0",
  "identifier": "com.macropad.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "bun scripts/dev-server.ts",
    "beforeBuildCommand": "bun run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macropad Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 660,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#18191b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
